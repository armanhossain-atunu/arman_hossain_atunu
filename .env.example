# Local PostgreSQL example. Replace with your real database URL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/portfolio_db?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-at-least-64-random-hex-characters"
PORT=4000
NODE_ENV=development

# Exact frontend origin; use your deployed HTTPS origin in production.
FRONTEND_ORIGIN="http://localhost:3000"

# Used only by the create-admin command.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
COOKIE_NAME="portfolio_admin"
